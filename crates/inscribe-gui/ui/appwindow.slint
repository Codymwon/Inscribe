import { Button, CheckBox, Switch, ProgressIndicator, ScrollView } from "std-widgets.slint";

export struct DriveItem {
    path: string,
    name: string,
    size-text: string,
    is-system: bool,
    is-flashable: bool,
    is-external-usb-ssd: bool,
    vendor: string,
    model: string,
    bus: string,
}

export component AppWindow inherits Window {
    title: "Inscribe - Fast, Safe Disk Imager";
    min-width: 820px;
    min-height: 520px;
    preferred-width: 860px;
    preferred-height: 540px;
    background: #1c1c1f;
    default-font-family: "Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif";

    // -------------------------------------------------------------------------
    // Component Properties (3-Step State & Progress)
    // -------------------------------------------------------------------------
    in-out property <bool> image-selected: false;
    in-out property <string> image-name: "";
    in-out property <string> image-size-text: "";
    in-out property <string> image-format-badge: "";

    in-out property <bool> drive-selected: false;
    in-out property <string> drive-name: "";
    in-out property <string> drive-size-text: "";
    in-out property <int> drive-count: 0;
    in-out property <[DriveItem]> drives: [];
    in-out property <int> selected-drive-index: -1;
    in-out property <bool> show-drive-modal: false;

    in-out property <bool> can-flash: false;
    in-out property <bool> is-flashing: false;
    in-out property <float> flash-progress: 0.0;
    in-out property <string> flash-speed-text: "";
    in-out property <string> flash-phase-text: "";
    in-out property <string> flash-eta-text: "";

    // -------------------------------------------------------------------------
    // Cancellation, Celebration & Error Dialog Properties
    // -------------------------------------------------------------------------
    in-out property <bool> show-cancel-modal: false;

    in-out property <bool> show-success-screen: false;
    in-out property <string> success-summary-text: "";
    in-out property <string> success-hash-text: "";

    in-out property <bool> show-error-screen: false;
    in-out property <string> error-title-text: "Flashing Failed";
    in-out property <string> error-message-text: "";

    in-out property <bool> drag-hover-active: false;

    // -------------------------------------------------------------------------
    // External USB SSD Modal & Safety Warning Properties
    // -------------------------------------------------------------------------
    in-out property <bool> show-usb-ssd-modal: false;
    in-out property <bool> allow-external-usb-ssd: false;

    in-out property <string> safety-warning-markdown: "**⚠️ Warning: Advanced Storage Mode**\n\nExternal USB SSDs may contain personal files or system backups. **Flashing will completely overwrite all data** on the selected drive.\n\nBy default, Inscribe blocks all non-removable media and internal buses (NVMe, SATA, SAS) to prevent catastrophic system data loss. Only enable this if you are certain your target is an external USB SSD enclosure.\n\nAll existing data, partitions, and files will be permanently destroyed.";

    in-out property <styled-text> safety-warning-styled: @markdown("**⚠️ Warning: Advanced Storage Mode**\n\nExternal USB SSDs may contain personal files or system backups. **Flashing will completely overwrite all data** on the selected drive.\n\nBy default, Inscribe blocks all non-removable media and internal buses (NVMe, SATA, SAS) to prevent catastrophic system data loss. Only enable this if you are certain your target is an external USB SSD enclosure.\n\nAll existing data, partitions, and files will be permanently destroyed.");

    // -------------------------------------------------------------------------
    // Callbacks
    // -------------------------------------------------------------------------
    callback select-image-clicked();
    callback select-drive-clicked();
    callback drive-selected-by-index(int);
    callback refresh-drives-clicked();
    callback flash-clicked();
    callback cancel-flash-clicked();
    callback confirm-cancel-clicked();
    callback dismiss-cancel-modal-clicked();
    callback dismiss-result-clicked();
    callback toggle-usb-ssd-modal-clicked();
    callback file-dropped(string);

    forward-focus: main-scope;

    main-scope := FocusScope {
        // Keyboard Shortcuts
        KeyBinding {
            keys: @keys(Control + O);
            activated => {
                root.select-image-clicked();
            }
        }

        KeyBinding {
            keys: @keys(Control + D);
            activated => {
                root.select-drive-clicked();
            }
        }

        KeyBinding {
            keys: @keys(Control + Return);
            activated => {
                if root.can-flash && !root.is-flashing {
                    root.flash-clicked();
                }
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if root.show-cancel-modal {
                    root.show-cancel-modal = false;
                    root.dismiss-cancel-modal-clicked();
                }
                if root.show-usb-ssd-modal {
                    root.show-usb-ssd-modal = false;
                }
                if root.show-drive-modal {
                    root.show-drive-modal = false;
                }
                if root.show-success-screen || root.show-error-screen {
                    root.show-success-screen = false;
                    root.show-error-screen = false;
                    root.dismiss-result-clicked();
                }
            }
        }

        // ---------------------------------------------------------------------
        // Main Application Layout
        // ---------------------------------------------------------------------
        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // Top Header Bar
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: "INSCRIBE";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f3f3f3;
                            letter-spacing: 1.5px;
                        }

                        Rectangle {
                            border-radius: 4px;
                            background: #0078d42a;
                            border-width: 1px;
                            border-color: #0078d480;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                Text {
                                    text: "v0.1.0";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #60cdff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Safe, streaming, zero-buffer direct block imager";
                        font-size: 13px;
                        color: #9e9e9e;
                    }
                }

                // Settings & Safety Warning Toggle Pill
                Rectangle {
                    border-radius: 6px;
                    background: root.allow-external-usb-ssd ? #d83b0126 : #2a2a2d;
                    border-width: 1px;
                    border-color: root.allow-external-usb-ssd ? #d83b01 : #3e3e42;
                    height: 36px;

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Toggle External USB SSD safety settings";
                        clicked => {
                            root.toggle-usb-ssd-modal-clicked();
                            root.show-usb-ssd-modal = !root.show-usb-ssd-modal;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.allow-external-usb-ssd ? "⚠️ USB SSD: ALLOWED" : "🛡️ USB SSD: BLOCKED";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.allow-external-usb-ssd ? #ff8c00 : #cccccc;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // Iconic 3-Step Cards
            // -----------------------------------------------------------------
            HorizontalLayout {
                spacing: 18px;

                // Step 1: Select Image Card
                step1-card := Rectangle {
                    border-radius: 8px;
                    background: (drop-zone.has-drag || root.drag-hover-active) ? #0078d41a : #242427;
                    border-width: (drop-zone.has-drag || root.drag-hover-active) ? 2px : 1px;
                    border-color: (drop-zone.has-drag || root.drag-hover-active) ? #0078d4 : (root.image-selected ? #107c41 : #3a3a3e);
                    horizontal-stretch: 1;

                    drop-zone := DropArea {
                        width: 100%;
                        height: 100%;

                        can-drop(event) => {
                            return DragAction.copy;
                        }

                        dropped(event) => {
                            root.drag-hover-active = false;
                            return event.proposed-action;
                        }
                    }

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: root.image-selected ? #107c41 : #333338;

                                    Text {
                                        text: root.image-selected ? "✓" : "1";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Ctrl+O";
                                    font-size: 11px;
                                    color: #777777;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "1. Select Image";
                                font-size: 16px;
                                font-weight: 600;
                                color: #f3f3f3;
                            }

                            if !root.image-selected: Text {
                                text: (drop-zone.has-drag || root.drag-hover-active) ? "Drop disk image file here..." : "Drag & drop image here or click below to browse.";
                                font-size: 12px;
                                color: (drop-zone.has-drag || root.drag-hover-active) ? #60cdff : #9e9e9e;
                                wrap: word-wrap;
                            }

                            if root.image-selected: VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: root.image-name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Size: " + root.image-size-text;
                                    font-size: 12px;
                                    color: #4cc2ff;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: ".iso, .img, .xz, .gz, .zst, .bz2, .zip";
                                font-size: 10px;
                                color: #666666;
                                horizontal-alignment: center;
                            }

                            Button {
                                text: root.image-selected ? "Change Image" : "Select Image";
                                accessible-role: button;
                                accessible-label: root.image-selected ? "Change selected disk image" : "Select disk image from storage";
                                clicked => {
                                    root.select-image-clicked();
                                }
                            }
                        }
                    }
                }

                // Step 2: Select Target Drive Card
                step2-card := Rectangle {
                    border-radius: 8px;
                    background: #242427;
                    border-width: 1px;
                    border-color: root.drive-selected ? #107c41 : #3a3a3e;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: root.drive-selected ? #107c41 : #333338;

                                    Text {
                                        text: root.drive-selected ? "✓" : "2";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Ctrl+D";
                                    font-size: 11px;
                                    color: #777777;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "2. Select Target";
                                font-size: 16px;
                                font-weight: 600;
                                color: #f3f3f3;
                            }

                            if !root.drive-selected: Text {
                                text: root.drive-count > 0 ? (root.drive-count + " removable drive(s) detected.") : "Waiting for removable USB drive...";
                                font-size: 12px;
                                color: #9e9e9e;
                                wrap: word-wrap;
                            }

                            if root.drive-selected: VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: root.drive-name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Target capacity: " + root.drive-size-text;
                                    font-size: 12px;
                                    color: #4cc2ff;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "System & internal drives strictly protected";
                                font-size: 10px;
                                color: #666666;
                                horizontal-alignment: center;
                            }

                            Button {
                                text: root.drive-selected ? "Change Target" : "Select Drive";
                                accessible-role: button;
                                accessible-label: root.drive-selected ? "Change target drive" : "Select target drive";
                                clicked => {
                                    root.select-drive-clicked();
                                }
                            }
                        }
                    }
                }

                // Step 3: Flash! Action Card
                step3-card := Rectangle {
                    border-radius: 8px;
                    background: #242427;
                    border-width: 1px;
                    border-color: (root.can-flash && !root.is-flashing) ? #0078d4 : #3a3a3e;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: (root.can-flash && !root.is-flashing) ? #0078d4 : #333338;

                                    Text {
                                        text: "3";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Ctrl+Enter";
                                    font-size: 11px;
                                    color: #777777;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "3. Flash!";
                                font-size: 16px;
                                font-weight: 600;
                                color: #f3f3f3;
                            }

                            if !root.is-flashing: Text {
                                text: root.can-flash ? "Ready to flash! Pass 1 writes directly, Pass 2 verifies BLAKE3 bitstream." : "Select an image and removable target drive to start flashing.";
                                font-size: 12px;
                                color: root.can-flash ? #60cdff : #9e9e9e;
                                wrap: word-wrap;
                            }

                            if root.is-flashing: VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: root.flash-phase-text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                }

                                ProgressIndicator {
                                    progress: root.flash-progress;
                                }

                                Text {
                                    text: root.flash-speed-text;
                                    font-size: 11px;
                                    color: #9e9e9e;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;

                            if !root.is-flashing: Button {
                                text: "⚡ Flash!";
                                primary: true;
                                enabled: root.can-flash;
                                accessible-role: button;
                                accessible-label: "Start flashing image to target drive";
                                clicked => {
                                    root.flash-clicked();
                                }
                            }

                            if root.is-flashing: Button {
                                text: "Cancel Flashing";
                                accessible-role: button;
                                accessible-label: "Abort current flash operation";
                                clicked => {
                                    root.cancel-flash-clicked();
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Status / Security Notice Bar
            Rectangle {
                border-radius: 6px;
                background: #1e1e21;
                border-width: 1px;
                border-color: #333338;
                height: 32px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    Text {
                        text: "Drive Guard: System drives & internal buses protected";
                        font-size: 11px;
                        color: #107c41;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Direct I/O zero-copy • BLAKE3 verified";
                        font-size: 11px;
                        color: #777777;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // "Show External USB SSDs" Safety Warning Modal
        // ---------------------------------------------------------------------
        if root.show-usb-ssd-modal: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a6;

            // Block clicks from leaking behind the dialog
            TouchArea {
                accessible-role: none;
            }

            Rectangle {
                width: 580px;
                border-radius: 10px;
                background: #252528;
                border-width: 1px;
                border-color: #55555c;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "⚠️ Advanced Storage Settings";
                            font-size: 18px;
                            font-weight: 700;
                            color: #ffaa44;
                        }

                        Button {
                            text: "✕";
                            accessible-role: button;
                            accessible-label: "Close modal dialog";
                            clicked => {
                                root.show-usb-ssd-modal = false;
                            }
                        }
                    }

                    // Rich StyledText using compile-time @markdown syntax
                    ScrollView {
                        height: 180px;

                        StyledText {
                            text: root.safety-warning-styled;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #3e3e42;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        CheckBox {
                            text: "Allow External USB SSD Enclosures";
                            checked <=> root.allow-external-usb-ssd;
                        }

                        Button {
                            text: "Done";
                            primary: true;
                            accessible-role: button;
                            accessible-label: "Save settings and close modal";
                            clicked => {
                                root.show-usb-ssd-modal = false;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // "Select Target Drive" Selection Modal
        // ---------------------------------------------------------------------
        if root.show-drive-modal: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a6;

            // Block clicks from leaking behind the dialog
            TouchArea {
                accessible-role: none;
            }

            Rectangle {
                width: 620px;
                border-radius: 10px;
                background: #252528;
                border-width: 1px;
                border-color: #55555c;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "🎯 Select Target Drive";
                            font-size: 18px;
                            font-weight: 700;
                            color: #f3f3f3;
                        }

                        Button {
                            text: "✕";
                            accessible-role: button;
                            accessible-label: "Close drive selection dialog";
                            clicked => {
                                root.show-drive-modal = false;
                            }
                        }
                    }

                    if root.drives.length == 0: VerticalLayout {
                        alignment: center;
                        padding-top: 30px;
                        padding-bottom: 30px;
                        spacing: 8px;

                        Text {
                            text: "⏳ Searching for removable drives...";
                            font-size: 14px;
                            color: #9e9e9e;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Plug in a USB flash drive or SD card to begin.";
                            font-size: 12px;
                            color: #666666;
                            horizontal-alignment: center;
                        }
                    }

                    if root.drives.length > 0: ScrollView {
                        height: 240px;

                        VerticalLayout {
                            spacing: 8px;

                            for drive[idx] in root.drives: Rectangle {
                                border-radius: 6px;
                                background: drive.is-flashable ? (root.selected-drive-index == idx ? #0078d426 : #2d2d31) : #1e1e21;
                                border-width: 1px;
                                border-color: drive.is-flashable ? (root.selected-drive-index == idx ? #0078d4 : #3e3e42) : #2a2a2d;

                                TouchArea {
                                    enabled: drive.is-flashable;
                                    accessible-role: button;
                                    accessible-label: "Select " + drive.name;
                                    clicked => {
                                        root.drive-selected-by-index(idx);
                                        root.show-drive-modal = false;
                                    }
                                }

                                HorizontalLayout {
                                    padding: 12px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: drive.name;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: drive.is-flashable ? #ffffff : #777777;
                                            }

                                            Text {
                                                text: "(" + drive.path + ")";
                                                font-size: 11px;
                                                color: #888888;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            Text {
                                                text: "Size: " + drive.size-text;
                                                font-size: 11px;
                                                color: drive.is-flashable ? #4cc2ff : #666666;
                                            }

                                            Text {
                                                text: "•  Bus: " + drive.bus;
                                                font-size: 11px;
                                                color: #777777;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 8px;

                                        if drive.is-system: Rectangle {
                                            border-radius: 4px;
                                            background: #d83b0126;
                                            border-width: 1px;
                                            border-color: #d83b01;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;

                                                Text {
                                                    text: "⛔ System Drive";
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #ff8c00;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if !drive.is-system && drive.is-external-usb-ssd && !drive.is-flashable: Rectangle {
                                            border-radius: 4px;
                                            background: #d83b011a;
                                            border-width: 1px;
                                            border-color: #d83b0180;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;

                                                Text {
                                                    text: "⚠️ USB SSD (Blocked)";
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #ffaa44;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if !drive.is-system && drive.is-external-usb-ssd && drive.is-flashable: Rectangle {
                                            border-radius: 4px;
                                            background: #107c4126;
                                            border-width: 1px;
                                            border-color: #107c41;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;

                                                Text {
                                                    text: "⚠️ USB SSD (Allowed)";
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #60cdff;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if drive.is-flashable && !drive.is-external-usb-ssd: Rectangle {
                                            border-radius: 4px;
                                            background: #107c4126;
                                            border-width: 1px;
                                            border-color: #107c41;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;

                                                Text {
                                                    text: "✓ Removable";
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #4cc2ff;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #3e3e42;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        Button {
                            text: "🔄 Rescan Drives";
                            accessible-role: button;
                            accessible-label: "Rescan connected storage drives";
                            clicked => {
                                root.refresh-drives-clicked();
                            }
                        }

                        Button {
                            text: "Close";
                            accessible-role: button;
                            accessible-label: "Close target selection modal";
                            clicked => {
                                root.show-drive-modal = false;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Cancellation Confirmation Modal
        // ---------------------------------------------------------------------
        if root.show-cancel-modal: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a6;

            TouchArea {
                accessible-role: none;
            }

            Rectangle {
                width: 500px;
                border-radius: 10px;
                background: #252528;
                border-width: 1px;
                border-color: #d83b01;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "⚠️ Cancel Flashing?";
                            font-size: 18px;
                            font-weight: 700;
                            color: #ffaa44;
                        }

                        Button {
                            text: "✕";
                            accessible-role: button;
                            accessible-label: "Close cancellation dialog";
                            clicked => {
                                root.show-cancel-modal = false;
                                root.dismiss-cancel-modal-clicked();
                            }
                        }
                    }

                    Text {
                        text: "Are you sure you want to abort the flash operation in progress?\n\nHalting now will leave the target drive in an incomplete or corrupted state. You will need to re-flash the entire image before the drive can be booted or used.";
                        font-size: 13px;
                        color: #cccccc;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 1px;
                        background: #3e3e42;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        Button {
                            text: "Continue Flashing";
                            primary: false;
                            accessible-role: button;
                            accessible-label: "Dismiss confirmation and continue flashing";
                            clicked => {
                                root.show-cancel-modal = false;
                                root.dismiss-cancel-modal-clicked();
                            }
                        }

                        Button {
                            text: "Yes, Abort Flashing";
                            primary: true;
                            accessible-role: button;
                            accessible-label: "Confirm cancellation and halt flash worker";
                            clicked => {
                                root.show-cancel-modal = false;
                                root.confirm-cancel-clicked();
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Celebration / Success Screen
        // ---------------------------------------------------------------------
        if root.show-success-screen: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a6;

            TouchArea {
                accessible-role: none;
            }

            Rectangle {
                width: 560px;
                border-radius: 10px;
                background: #252528;
                border-width: 1px;
                border-color: #107c41;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 10px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: #107c41;

                            Text {
                                text: "✓";
                                font-size: 18px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "🎉 Flashing & Verification Complete!";
                            font-size: 18px;
                            font-weight: 700;
                            color: #107c41;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "The disk image has been written directly to physical storage and successfully verified bit-for-bit with cryptographic BLAKE3 checksums. The drive is now safe to unplug.";
                        font-size: 13px;
                        color: #cccccc;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        border-radius: 6px;
                        background: #1e1e21;
                        border-width: 1px;
                        border-color: #333338;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.success-summary-text;
                                font-size: 13px;
                                font-weight: 600;
                                color: #60cdff;
                            }

                            Text {
                                text: root.success-hash-text;
                                font-size: 11px;
                                color: #9e9e9e;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #3e3e42;
                    }

                    HorizontalLayout {
                        alignment: end;

                        Button {
                            text: "Done / Flash Another";
                            primary: true;
                            accessible-role: button;
                            accessible-label: "Close celebration screen and return to main window";
                            clicked => {
                                root.show-success-screen = false;
                                root.dismiss-result-clicked();
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Error Summary Screen
        // ---------------------------------------------------------------------
        if root.show-error-screen: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a6;

            TouchArea {
                accessible-role: none;
            }

            Rectangle {
                width: 560px;
                border-radius: 10px;
                background: #252528;
                border-width: 1px;
                border-color: #d83b01;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 10px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: #d83b01;

                            Text {
                                text: "!";
                                font-size: 18px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.error-title-text;
                            font-size: 18px;
                            font-weight: 700;
                            color: #ff8c00;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "An error occurred during flashing or verification:";
                        font-size: 13px;
                        color: #cccccc;
                    }

                    Rectangle {
                        border-radius: 6px;
                        background: #1e1e21;
                        border-width: 1px;
                        border-color: #d83b0140;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.error-message-text;
                                font-size: 12px;
                                color: #ffaa44;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #3e3e42;
                    }

                    HorizontalLayout {
                        alignment: end;

                        Button {
                            text: "Dismiss";
                            primary: true;
                            accessible-role: button;
                            accessible-label: "Dismiss error dialog";
                            clicked => {
                                root.show-error-screen = false;
                                root.dismiss-result-clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}
